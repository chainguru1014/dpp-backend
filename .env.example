PORT=5052
DATABASE=mongodb://127.0.0.1:27017/dpp

# Impinj R700 reader's OWN built-in REST API (direct, not via the .NET
# Octane-SDK reader-service) — reached from this host over the Tailscale
# subnet route a friend's laptop advertises on the reader's LAN.
# IMPINJ_REST_HOST is the reader's LAN IP (e.g. 192.168.x.x); leave blank
# to disable these routes (/impinj-rest/*) entirely.
IMPINJ_REST_HOST=
IMPINJ_REST_PORT=443
IMPINJ_REST_USERNAME=root
IMPINJ_REST_PASSWORD=impinj123
IMPINJ_REST_PRESET=default
# true only if the reader's factory self-signed cert is ever replaced
IMPINJ_REST_REJECT_UNAUTHORIZED=false

# Impinj R700 reader over LLRP/TCP directly (the reader's actual interface
# — no REST API on this reader after all; see /impinj-rest above, which
# this supersedes if LLRP checks out). Same Tailscale subnet route as above.
IMPINJ_LLRP_HOST=
IMPINJ_LLRP_PORT=5084
IMPINJ_LLRP_ROSPEC_ID=123
API_BASE_URL=https://api.innosynch.com/
REMOTE_FILES_BASE_URL=https://api.innosynch.com/files
# Public app / product-page URL embedded in QR codes
PUBLIC_APP_URL=https://dpp.innosynch.com
# Public app URL embedded in transfer links / emails
PUBLIC_WEB_APP_URL=https://dpp.innosynch.com
# OpenAI — powers the Chat assistant and AI Recommendations (server-side only).
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Auth (JWT + passwordless sign-in) ---
# Required. The server refuses to start without this — no insecure default.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# SMTP — used for transfer invite emails and email OTP codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Sign-In — POST /auth/google verifies the ID token's audience against
# whichever of these are set (web/Android/iOS OAuth client ids).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Apple Sign-In — POST /auth/apple verifies the identityToken's audience
# against APPLE_CLIENT_ID (comma-separate multiple service/app ids if needed).
# APPLE_TEAM_ID/APPLE_KEY_ID/APPLE_PRIVATE_KEY are only needed if this backend
# ever generates its own Apple client secret (e.g. for server-to-server calls).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=
APPLE_PRIVATE_KEY=
